/* Design tokens for {{ tokens.color.brand.primary.value if tokens.color.brand.primary else "extracted site" }}
 * Generated by dna-website
 *
 * Drop this into your project as a starting point, or use it as a reference
 * for your own design system.
 */

:root {
  /* ─── Colors ─── */
  {% if tokens.color.brand.primary %}--color-brand-primary: {{ tokens.color.brand.primary.value }};{% endif %}
  {% if tokens.color.brand.secondary %}--color-brand-secondary: {{ tokens.color.brand.secondary.value }};{% endif %}

  {% for k, v in tokens.color.neutrals.items() %}--color-neutral-{{ k }}: {{ v.value }};
  {% endfor %}

  {% if tokens.color.accent.success %}--color-success: {{ tokens.color.accent.success.value }};{% endif %}
  {% if tokens.color.accent.warning %}--color-warning: {{ tokens.color.accent.warning.value }};{% endif %}
  {% if tokens.color.accent.danger %}--color-danger:  {{ tokens.color.accent.danger.value }};{% endif %}
  {% if tokens.color.accent.info %}--color-info:    {{ tokens.color.accent.info.value }};{% endif %}

  /* ─── Typography ─── */
  {% for name, fam in tokens.typography.families.items() %}--font-family-{{ name }}: {{ fam.stack }};
  {% endfor %}

  {% for k, v in tokens.typography.scale.sizes.items() %}--font-size-{{ k }}: {{ v.rem }}rem;
  {% endfor %}

  {% for k, v in tokens.typography.line_heights.items() %}--line-height-{{ k }}: {{ v }};
  {% endfor %}

  /* ─── Spacing ─── */
  {% for k, v in tokens.spacing.scale.items() %}--space-{{ k }}: {{ v.rem }}rem;
  {% endfor %}

  /* ─── Radii ─── */
  {% for k, v in tokens.radius.scale.items() %}--radius-{{ k }}: {{ "9999px" if v == 9999 else v ~ "px" }};
  {% endfor %}

  /* ─── Shadows ─── */
  {% for k, v in tokens.shadow.scale.items() %}--shadow-{{ k }}: {{ v }};
  {% endfor %}

  /* ─── Motion ─── */
  {% for k, v in tokens.motion.duration.items() %}--duration-{{ k }}: {{ v }};
  {% endfor %}
  {% for k, v in tokens.motion.easing.items() %}--easing-{{ k }}: {{ v }};
  {% endfor %}
}

/* ─── Breakpoints (use in media queries as reference) ─── */
{% for k, v in tokens.breakpoint.scale.items() %}/* --breakpoint-{{ k }}: {{ v }}; */
{% endfor %}
