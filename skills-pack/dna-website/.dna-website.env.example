# DNA-website credentials file
# Copy to .dna-website.env and fill in. NEVER commit .dna-website.env.
#
# Format: one [profile-name] block per site. Reference profiles with --auth <profile-name>.
#
# Selectors use standard CSS selector syntax. Inspect the login form in DevTools
# to find them. If selectors fail, set MANUAL_LOGIN=true to log in by hand in
# the Chrome MCP window.

[example]
LOGIN_URL=https://app.example.com/login
USERNAME=you@example.com
PASSWORD=replace-me
USERNAME_SELECTOR=input[name="email"]
PASSWORD_SELECTOR=input[name="password"]
SUBMIT_SELECTOR=button[type="submit"]
# Tool waits until the URL contains this substring before considering login successful
POST_LOGIN_URL_CONTAINS=/dashboard
# Or wait for a specific element to appear instead/additionally
POST_LOGIN_SELECTOR=[data-testid="user-menu"]
# 2FA mode: "none" | "manual" | "totp:<base32-secret>"
# manual = pause and let the user complete 2FA in the open browser window
TWO_FACTOR=manual
# If true, skip selector-based login entirely and let the user log in by hand
MANUAL_LOGIN=false
# Optional: cookie domain to scope session export (defaults to the LOGIN_URL host)
COOKIE_DOMAIN=.example.com

# Add more profiles below
# [other-site]
# LOGIN_URL=...
